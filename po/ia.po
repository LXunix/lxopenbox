#: openbox/client.c:3722
#, c-format
msgid ""
"The window \"%s\" does not seem to be responding.  Do you want to force it "
"to exit by sending the %s signal?"
msgstr ""
"Le fenestra \"%s\" non sembla esser respondente. Vole tu fortiar lo a sortir "
"per inviar le signal %s?"

#: openbox/client.c:3724
msgid "End Process"
msgstr "Finir processo"

#: openbox/client.c:3728
#, c-format
msgid ""
"The window \"%s\" does not seem to be responding.  Do you want to disconnect "
"it from the X server?"
msgstr ""
"Le fenestra \"%s\" non sembla esser respondente. Vole tu disconnecter lo del "
"servitor X?"

#: openbox/client.c:3730
msgid "Disconnect"
msgstr "Disconnecter"

