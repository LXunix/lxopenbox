msgid "Copyright (c)"
msgstr "著作權 (c)"

#: openbox/openbox.c:536
msgid "Syntax: openbox [options]\n"
msgstr "語法：openbox [選項]\n"

#: openbox/openbox.c:537
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項：\n"

#: openbox/openbox.c:538
msgid "  --help              Display this help and exit\n"
msgstr "  --help              顯示此說明然後離開\n"

#: openbox/openbox.c:539
msgid "  --version           Display the version and exit\n"
msgstr "  --version           顯示版本然後離開\n"

#: openbox/openbox.c:540
msgid "  --replace           Replace the currently running window manager\n"
msgstr "  --replace           替換目前執行的視窗管理員\n"

#. TRANSLATORS: if you translate "FILE" here, make sure to keep the "Specify..."
#. aligned still, if you have to, make a new line with \n and 22 spaces. It's
#. fine to leave it as FILE though.
#: openbox/openbox.c:544
msgid "  --config-file FILE  Specify the path to the config file to use\n"
msgstr "  --config-file <檔案>  指定要使用的設定檔路徑\n"

#: openbox/openbox.c:545
msgid "  --sm-disable        Disable connection to the session manager\n"
msgstr "  --sm-disable        停用與執行階段管理程式的連結\n"

#: openbox/openbox.c:546
msgid ""
"\n"
"Passing messages to a running Openbox instance:\n"
msgstr ""
"\n"
"傳遞訊息到執行中的 Openbox 實體：\n"

#: openbox/openbox.c:547
msgid "  --reconfigure       Reload Openbox's configuration\n"
msgstr "  --reconfigure       重新載入 Openbox 配置\n"

#: openbox/openbox.c:548
msgid "  --restart           Restart Openbox\n"
msgstr "  --restart           重新啟動 Openbox\n"

#: openbox/openbox.c:549
msgid "  --exit              Exit Openbox\n"
msgstr "  --exit              結束 Openbox\n"

#: openbox/openbox.c:550
msgid ""
"\n"
"Debugging options:\n"
msgstr ""
"\n"
"偵錯選項：\n"

#: openbox/openbox.c:551
msgid "  --sync              Run in synchronous mode\n"
msgstr "  --sync              在同步模式中運行\n"

#: openbox/openbox.c:552
msgid "  --startup CMD       Run CMD after starting\n"
msgstr ""

#: openbox/openbox.c:553
msgid "  --debug             Display debugging output\n"
msgstr "  --debug             顯示偵錯輸出\n"

#: openbox/openbox.c:554
msgid "  --debug-focus       Display debugging output for focus handling\n"
msgstr "  --debug-focus       顯示焦點處理的偵錯輸出\n"

#: openbox/openbox.c:555
msgid "  --debug-session     Display debugging output for session management\n"
msgstr ""

#: openbox/openbox.c:556
msgid "  --debug-xinerama    Split the display into fake xinerama screens\n"
msgstr "  --debug-xinerama    分割顯示以進入假造的 xinerama 螢幕\n"

#: openbox/openbox.c:557
#, c-format
msgid ""
"\n"
"Please report bugs at %s\n"
msgstr ""
"\n"
"請向 %s 報告錯誤\n"

#: openbox/openbox.c:640 openbox/openbox.c:674
#, c-format
msgid "%s requires an argument\n"
msgstr "%s 需要一個參數\n"

#: openbox/openbox.c:717
#, c-format
msgid "Invalid command line argument \"%s\"\n"
msgstr "無效的命令列引數「%s」\n"

#: openbox/screen.c:106 openbox/screen.c:191
#, c-format
msgid "A window manager is already running on screen %d"
msgstr "螢幕 %d 中已經有視窗管理員在運行"

#: openbox/screen.c:127
#, c-format
msgid "Could not acquire window manager selection on screen %d"
msgstr "無法於螢幕 %d 獲選為視窗管理員"

#: openbox/screen.c:150
#, c-format
msgid "The WM on screen %d is not exiting"
msgstr "螢幕 %d 中的視窗管理員並未離開"

#. TRANSLATORS: If you need to specify a different order of the
#. arguments, you can use %1$d for the first one and %2$d for the
#. second one. For example,
#. "The current session has %2$d desktops, but Openbox is configured for %1$d ..."
#: openbox/screen.c:404
#, c-format
msgid ""
"Openbox is configured for %d desktop, but the current session has %d.  "
"Overriding the Openbox configuration."
msgid_plural ""
"Openbox is configured for %d desktops, but the current session has %d.  "
"Overriding the Openbox configuration."
msgstr[0] ""
"Openbox 原先被設定為使用 %d 個桌面，但目前的作業階段有其他程式變更設定為 %d "
"個，因此忽略 Openbox 的設定"

#: openbox/screen.c:1213
#, c-format
msgid "desktop %i"
msgstr "桌面 %i"

