msgstr ""
"Échec de l'ouverture de l'affichage depuis la variable d'environnement "
"DISPLAY."

#: openbox/openbox.c:183
msgid "Failed to initialize the obrender library."
msgstr "Échec de l'initialisation de la bibliothèque obrender."

